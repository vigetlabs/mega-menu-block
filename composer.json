{
  "name": "viget/mega-menu-block",
  "description": "A custom block that enables mega menu functionality within Navigation blocks, allowing any blocks to be added as children of Navigation items.",
  "keywords": [
    "wordpress",
    "gutenberg",
    "block",
    "navigation",
    "mega-menu"
  ],
  "type": "wordpress-plugin",
  "homepage": "https://github.com/vigetlabs/mega-menu-block",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Viget",
      "homepage": "https://viget.com/"
    }
  ],
  "require": {
    "php": ">=7.4",
    "composer/installers": "^1.0 || ^2.0"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true
    },
    "platform": {
      "php": "7.4"
    }
  }
}
