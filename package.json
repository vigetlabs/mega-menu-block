{
	"name": "mega-menu-block",
	"version": "1.1.0",
	"description": "A custom block that enables mega menu functionality within Navigation blocks, allowing any blocks to be added as children of Navigation items.",
	"author": "Viget",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:php": "phpcs --standard=.phpcs.xml .",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"postversion": "git push && git push --tags",
		"release": "npm version",
		"start": "wp-scripts start",
		"update-pot": "wp-env run cli wp i18n make-pot wp-content/plugins/mega-menu-block wp-content/plugins/mega-menu-block/languages/mega-menu-block.pot --exclude=build,node_modules,bin,vendor",
		"version": "node bin/sync-version.js && git add mega-menu-block.php readme.txt"
	},
	"devDependencies": {
		"@wordpress/env": "^11.15.0",
		"@wordpress/scripts": "^35.0.0",
		"raw-loader": "^4.0.2",
		"typescript": "^5.9.3",
		"webpack-remove-empty-scripts": "^1.0.4"
	},
	"dependencies": {
		"@wordpress/block-editor": "^13.0.0",
		"@wordpress/blocks": "^13.0.0",
		"@wordpress/components": "^28.0.0",
		"@wordpress/data": "^10.0.0",
		"@wordpress/element": "^6.0.0",
		"@wordpress/hooks": "^4.0.0",
		"@wordpress/i18n": "^5.0.0"
	},
	"homepage": "https://github.com/vigetlabs/mega-menu-block",
	"repository": {
		"type": "git",
		"url": "https://github.com/vigetlabs/mega-menu-block.git"
	},
	"files": [
		"build",
		"includes",
		"languages",
		"block.json",
		"mega-menu-block.php",
		"uninstall.php",
		"readme.txt",
		"LICENSE"
	]
}
